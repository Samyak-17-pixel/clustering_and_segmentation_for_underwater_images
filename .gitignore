# Only code and methodology are versioned (README.md, results.md, docs/, src/, build scripts).
# Datasets, results, caches, models, videos and decks stay on the local disk.

# datasets and raw footage (see data/README.md for how to obtain / rebuild them)
data/*
!data/README.md
videos/

# everything the scripts produce
results/
outputs/

# presentations: keep only the build scripts
presentations/*
!presentations/build_deck.py
!presentations/build_deck_review3.py
!presentations/build_figures.py
!presentations/build_figures_review3.py

# python, logs, media, office files
__pycache__/
*.pyc
*.log
*.pptx
*.pdf
*.mp4
*.npy
*.pkl
*.pt
*.pth
*.h5
.venv/
